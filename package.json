{
  "name": "website-mcp",
  "version": "0.1.0",
  "description": "Turn a website into a deterministic tool: explore once with a model, then run the saved script with no model.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "playwright",
    "browser-automation",
    "web-automation",
    "chrome-extension",
    "deterministic",
    "tools"
  ],
  "type": "module",
  "bin": {
    "website-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "authoring",
    "extension",
    "plugin",
    "docs/safety.md",
    "docs/model-seam.md",
    "docs/prior-art.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node tools/content-scan.mjs && node --test \"test/unit/*.test.mjs\" \"test/browser/*.test.mjs\" \"test/extension/*.test.mjs\"",
    "prepack": "npm test",
    "serve": "node dist/cli.js serve"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdinathChaudhari/website-mcp.git"
  },
  "homepage": "https://github.com/AdinathChaudhari/website-mcp#readme",
  "bugs": {
    "url": "https://github.com/AdinathChaudhari/website-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "playwright": "1.65.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
