{
  "name": "profile_page_write",
  "description": "Fill the profile form in the open tab; the user presses Save.",
  "effect": "write",
  "kind": "page",
  "site": { "allowedOrigins": ["__ORIGIN__"] },
  "timeoutSec": 20,
  "input": {
    "type": "object",
    "properties": { "name": { "type": "string", "minLength": 1 }, "waitSec": { "type": "number" } },
    "required": ["name"],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": { "committed": { "type": "boolean" } },
    "required": ["committed"]
  }
}
